{
  "name": "am-tech-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "build": "npm --prefix web install && npm --prefix web run build",
    "start:production": "node src/server.js",
    "desktop:dev": "node scripts/prepare-desktop.mjs && electron .",
    "desktop:pack": "node scripts/prepare-desktop.mjs && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "pg": "^8.13.1"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.amtechsolutions.platform",
    "productName": "AM Tech Platform",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
