{
  "name": "am-tech-platform",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build && node scripts/check-deployment.mjs",
    "start:production": "node src/server.js",
    "desktop:dev": "node scripts/prepare-desktop.mjs && electron .",
    "desktop:pack": "node scripts/prepare-desktop.mjs && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "5.10.0",
    "pg": "8.23.1"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.com.amtechsolutions.platform",
    "productName": "AM Tech Platform",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/am-tech.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "desktop/assets/am-tech.ico",
      "uninstallerIcon": "desktop/assets/am-tech.ico"
    }
  }
}
